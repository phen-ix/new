# SPDX-License-Identifier: GPL-2.0
#
# DOOM Kernel — HyperOS compatibility fragment (miatoll)
# ==========================================================================
# THIS FILE IS NOT REFERENCED BY ANY DEFCONFIG OR MAKEFILE.
#
# It is inert until you merge it explicitly:
#
#   make ARCH=arm64 O=out vendor/atoll-perf_defconfig vendor/xiaomi/miatoll_defconfig
#   ARCH=arm64 scripts/kconfig/merge_config.sh -O out \
#       out/.config arch/arm64/configs/vendor/xiaomi/hyperos_compat.config
#   make ARCH=arm64 O=out olddefconfig
#
# Rationale for keeping it out of the base defconfig: the base config must stay
# ROM-agnostic (project rule). Only a HyperOS build merges this file.
#
# Only additive capabilities live here. Nothing in this file changes scheduling,
# frequency, thermal or memory behaviour: it only makes the kernel able to
# *consume* formats/interfaces a modern HyperOS userspace may ship.
# ==========================================================================

# ---------------------------------------------------------------------------
# EROFS (gate E-14)
#
# fs/erofs exists in this tree (fs/Kconfig), but no arm64 config enables it:
#     grep -rn EROFS arch/arm64/configs/   ->  no results
# Every Android 12+ system/vendor/product/system_ext image produced by the
# standard tooling is EROFS. If the target ROM's super.img reports erofs
# (hyperos/tools/rom-evidence.sh -> dossier/08-filesystems.txt), the kernel
# cannot mount it without these. If the ROM is ext4 or the port converts it,
# these options are unused dead weight (~120 KiB) and must be dropped again.
# ---------------------------------------------------------------------------
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_SECURITY=y
# fixed-output compression support; needed only if the image uses compressed
# clusters (check with `fsck.erofs --extract` output / image tooling)
CONFIG_EROFS_FS_ZIP=y

# ---------------------------------------------------------------------------
# TMPFS_XATTR
#
# fs/Kconfig:177 -> default n, and neither atoll nor miatoll config enables it.
# Required only by overlays whose upper/work directory is on tmpfs, or by any
# component that sets security.* xattrs on tmpfs. Verify against the ROM's
# fstab/init (dossier 07/08) before enabling: it is additive but it does change
# what tmpfs accepts.
# ---------------------------------------------------------------------------
CONFIG_TMPFS_XATTR=y

# ---------------------------------------------------------------------------
# CANDIDATES — deliberately disabled. Uncomment ONLY with ROM evidence.
#
# CONFIG_KEYS=y
#     security/keys/Kconfig default n. Enable if a ROM service uses keyctl /
#     request_key (check dossier 06 for such a service); otherwise unused.
#
# CONFIG_USER_NS=y
#     init/Kconfig:1054 default n. Only if the ROM ships a sandbox that needs
#     user namespaces; Android itself does not require it on this target.
#
# CONFIG_MQ_IOSCHED_DEADLINE=y
# CONFIG_IOSCHED_BFQ=y
#     block/Kconfig.iosched: both currently unset; MQ_IOSCHED_DEADLINE and
#     MQ_IOSCHED_KYBER are explicitly disabled in miatoll_defconfig:61-62 and
#     IOSCHED_CFQ is used. Changing the I/O scheduler is a measured decision
#     (E-12), not a default — and BFQ costs CPU on a 4.14 kernel with 2 big
#     cores, which is exactly the wrong trade for sustained UI smoothness
#     unless the block trace proves I/O stalls dominate.
#
# CONFIG_ZRAM_WRITEBACK=y
#     needs a backing swap device and a ROM that configures it; the target ROM
#     ships a zram-only setup (no swap partition) as far as the archive layout
#     shows. Do not enable without dossier evidence for E-11.
# ---------------------------------------------------------------------------
